{
  "schema": 2,
  "dashboard": "https://dashboard.cachyos.org/",
  "mirrors": "https://dashboard.cachyos.org/mirrors",
  "optimizedRepositories": {
    "documentation": "https://wiki.cachyos.org/features/optimized_repos/",
    "architectures": ["x86-64-v3", "x86-64-v4", "znver4"],
    "policy": "metadata-only-on-msys2"
  },
  "gaming": {
    "documentation": "https://wiki.cachyos.org/configuration/gaming/",
    "proton": "proton-cachyos-slr",
    "wine": "wine-cachyos-opt",
    "ntsync": true,
    "components": ["dxvk", "vkd3d-proton", "umu-launcher", "gamescope"]
  },
  "kernel": {
    "documentation": "https://wiki.cachyos.org/features/kernel/",
    "default": "linux-cachyos",
    "compiler": "clang-thinlto",
    "profile": "autofdo",
    "tickRateHz": 1000,
    "schedulers": ["BORE", "EEVDF", "BMQ"],
    "variants": ["default", "bore", "bmq", "deckify", "eevdf", "lts", "hardened", "rc", "server", "rt-bore"],
    "modules": ["nvidia-open", "zfs"]
  },
  "omarchy": {
    "repository": "https://github.com/omacom/omarchy-pkgs.git",
    "packages": "https://pkgs.omarchy.org",
    "channels": ["edge", "rc", "stable"],
    "architectures": ["x86_64", "aarch64"],
    "recipeRoot": "pkgbuilds"
  },
  "pipeline": {
    "layers": ["omarchy", "cachyos", "msys2", "emulation", "builders"],
    "emulators": ["dust", "gopher64", "jgenesis", "retroboy", "rustboyadvance-ng", "starpsx", "tetanes", "zakuro"],
    "builders": [
      {
        "name": "bun-engine",
        "base": "engine",
        "path": "package.json",
        "command": ["bun", "run", "build"]
      },
      {
        "name": "cargo-workspace",
        "base": "workspace",
        "path": "scripts/cargo.ts",
        "command": ["bun", "scripts/cargo.ts", "exec", "--", "metadata", "--locked", "--no-deps"]
      },
      {
        "name": "msys2-pacman",
        "base": "sources",
        "path": "msys2-packages/cachyos-msys2/PKGBUILD",
        "command": ["makepkg", "--cleanbuild", "--clean", "--force"]
      },
      {
        "name": "omarchy-packages",
        "base": "sources",
        "path": "omarchy-pkgs/bin/build",
        "command": ["bin/build", "--dry-run"]
      }
    ],
    "emulatorRoot": "crates"
  },
  "sources": [
    {
      "name": "linux",
      "path": "linux-cachyos",
      "origin": "https://github.com/aphrody-labs/linux-cachyos.git",
      "upstream": "https://github.com/CachyOS/linux-cachyos.git"
    },
    {
      "name": "kernel-patches",
      "path": "kernel-patches",
      "origin": "https://github.com/aphrody-labs/kernel-patches.git",
      "upstream": "https://github.com/CachyOS/kernel-patches.git"
    },
    {
      "name": "proton",
      "path": "proton-cachyos",
      "origin": "https://github.com/aphrody-labs/proton-cachyos.git",
      "upstream": "https://github.com/CachyOS/proton-cachyos.git"
    },
    {
      "name": "wine",
      "path": "wine-cachyos",
      "origin": "https://github.com/aphrody-labs/wine-cachyos.git",
      "upstream": "https://github.com/CachyOS/wine-cachyos.git"
    },
    {
      "name": "wiki",
      "path": "wiki",
      "origin": "https://github.com/aphrody-labs/wiki.git",
      "upstream": "https://github.com/CachyOS/wiki.git",
      "sourceId": "cachyos-wiki"
    },
    {
      "name": "chwd",
      "path": "chwd",
      "origin": "https://github.com/aphrody-labs/chwd.git",
      "upstream": "https://github.com/CachyOS/chwd.git"
    },
    {
      "name": "pkg-manage-util",
      "path": "pkg-manage-util",
      "origin": "https://github.com/aphrody-labs/pkg-manage-util.git",
      "upstream": "https://github.com/CachyOS/pkg-manage-util.git"
    },
    {
      "name": "open-gpu-kernel-modules",
      "path": "open-gpu-kernel-modules",
      "origin": "https://github.com/aphrody-labs/open-gpu-kernel-modules.git",
      "upstream": "https://github.com/CachyOS/open-gpu-kernel-modules.git"
    },
    {
      "name": "omarchy-pkgs",
      "path": "omarchy-pkgs",
      "kind": "external",
      "origin": "https://github.com/omacom/omarchy-pkgs.git",
      "upstream": "https://github.com/omacom/omarchy-pkgs.git"
    },
    {
      "name": "omarchy",
      "path": "omarchy",
      "kind": "external",
      "origin": "https://github.com/omacom/omarchy.git",
      "upstream": "https://github.com/omacom/omarchy.git"
    }
  ]
}
